# Cross-platform distcheck script generated by jrl-cmakemodules.
# Do not edit — regenerated every time CMake configures the project.
cmake_minimum_required(VERSION 3.22)

set(dist_srcdir "@_dist_srcdir@")
set(dist_builddir "@_dist_builddir@")
set(dist_instdir "@_dist_instdir@")
set(project_name "@PROJECT_NAME@")
set(project_version "@PROJECT_VERSION@")
set(cmake_command "@CMAKE_COMMAND@")

find_program(ctest_command NAMES ctest)
if(NOT ctest_command)
    message(FATAL_ERROR "[distcheck] Could not find 'ctest' in PATH.")
endif()

# ---------------------------------------------------------------------------
# 1. Check that the source distribution was prepared by jrl_release.py --dist
# ---------------------------------------------------------------------------
if(NOT EXISTS "${dist_srcdir}")
    message(
        FATAL_ERROR
        "dist source directory not found: ${dist_srcdir}\n"
        "Run: jrl_release.py --dist --build-dir <build_dir>"
    )
endif()

# ---------------------------------------------------------------------------
# 2. Reset the build and install directories
# ---------------------------------------------------------------------------
message(STATUS "[distcheck] Resetting build and install directories...")
file(REMOVE_RECURSE "${dist_builddir}" "${dist_instdir}")
file(MAKE_DIRECTORY "${dist_builddir}" "${dist_instdir}")

# ---------------------------------------------------------------------------
# 3. Configure
# ---------------------------------------------------------------------------
message(STATUS "[distcheck] Configuring...")
execute_process(
    COMMAND
        "${cmake_command}" "-DCMAKE_INSTALL_PREFIX=${dist_instdir}" "-DCMAKE_BUILD_TYPE=Release"
        "${dist_srcdir}"
    WORKING_DIRECTORY "${dist_builddir}"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "[distcheck] cmake configuration failed.")
endif()

# ---------------------------------------------------------------------------
# 4. Build
# ---------------------------------------------------------------------------
message(STATUS "[distcheck] Building...")
execute_process(
    COMMAND "${cmake_command}" --build . --config Release
    WORKING_DIRECTORY "${dist_builddir}"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "[distcheck] Build failed.")
endif()

# ---------------------------------------------------------------------------
# 5. Test
# ---------------------------------------------------------------------------
message(STATUS "[distcheck] Testing...")
execute_process(
    COMMAND "${ctest_command}" --test-dir "${dist_builddir}" -C Release --output-on-failure
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "[distcheck] Tests failed.")
endif()

# ---------------------------------------------------------------------------
# 6. Install
# ---------------------------------------------------------------------------
message(STATUS "[distcheck] Installing...")
execute_process(
    COMMAND "${cmake_command}" --build . --target install --config Release
    WORKING_DIRECTORY "${dist_builddir}"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "[distcheck] Install failed.")
endif()

# ---------------------------------------------------------------------------
# 7. Uninstall
# ---------------------------------------------------------------------------
message(STATUS "[distcheck] Uninstalling...")
execute_process(
    COMMAND "${cmake_command}" --build . --target uninstall --config Release
    WORKING_DIRECTORY "${dist_builddir}"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "[distcheck] Uninstall failed.")
endif()

# ---------------------------------------------------------------------------
# 8. Verify that uninstall removed all installed files
# ---------------------------------------------------------------------------
file(GLOB_RECURSE remaining_files LIST_DIRECTORIES false "${dist_instdir}/*")
if(remaining_files)
    string(JOIN "\n  " remaining_str ${remaining_files})
    message(FATAL_ERROR "[distcheck] Uninstall target left files behind:\n  ${remaining_str}")
endif()

# ---------------------------------------------------------------------------
# 9. Clean
# ---------------------------------------------------------------------------
message(STATUS "[distcheck] Cleaning...")
execute_process(
    COMMAND "${cmake_command}" --build . --target clean --config Release
    WORKING_DIRECTORY "${dist_builddir}"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "[distcheck] Clean failed.")
endif()

# ---------------------------------------------------------------------------
# 10. Final cleanup
# ---------------------------------------------------------------------------
file(REMOVE_RECURSE "${dist_builddir}" "${dist_instdir}")

message(STATUS "=====================================================")
message(STATUS "${project_name}-${project_version} is ready for distribution.")
message(STATUS "=====================================================")
